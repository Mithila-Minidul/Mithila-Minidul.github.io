---
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
---
<header class="hero">
  <div class="scene"><slot name="scene" /></div>
  <div class="wrap content">
    <h1>{site.headline}</h1>
    <p class="lead">{site.intro}</p>
    <div class="actions hero-actions">
      <Button href="#work" class="hero-primary">See my work</Button>
      <Button href="#contact" variant="ghost" class="hero-ghost">Get in touch</Button>
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
  }
  .scene {
    position: absolute;
    z-index: 0;
    inset: 0 0 -180px;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 76%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 76%, transparent 100%);
  }
  .content { position: relative; z-index: 1; padding-block: 140px 80px; }
  h1 {
    font-size: var(--text-h1);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 650;
    margin: 0 0 24px;
    max-width: 13ch;
    animation: hero-copy-arrive 900ms cubic-bezier(0.22, 1, 0.36, 1) 100ms both;
  }
  .lead {
    font-size: var(--text-lg);
    color: var(--slate);
    max-width: 46ch;
    margin: 0 0 36px;
    animation: hero-copy-arrive 900ms cubic-bezier(0.22, 1, 0.36, 1) 220ms both;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    animation: hero-copy-arrive 900ms cubic-bezier(0.22, 1, 0.36, 1) 340ms both;
  }
  @keyframes hero-copy-arrive {
    from { opacity: 0; transform: translateY(16px); filter: blur(4px); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  .hero-actions :global(.hero-primary),
  .hero-actions :global(.hero-ghost) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    transition:
      transform 0.25s var(--spring),
      color 220ms ease,
      box-shadow 220ms ease;
  }
  .hero-actions :global(.hero-primary) {
    transition-delay: 0s, 560ms, 560ms;
  }
  .hero-actions :global(.hero-ghost) {
    transition-delay: 0s, 0s, 0s;
  }
  .hero-actions :global(.hero-primary)::before,
  .hero-actions :global(.hero-ghost)::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    transform: scaleX(0);
    transition: transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .hero-actions :global(.hero-primary)::before {
    background: var(--fog);
    transform-origin: left center;
    transition-delay: 560ms;
  }
  .hero-actions :global(.hero-ghost)::before {
    background: var(--blue);
    transform-origin: left center;
    transition-delay: 0s;
  }
  .hero-actions :global(.hero-ghost) { color: var(--ink); }

  .hero-actions:has(:global(.hero-ghost:hover)) :global(.hero-ghost)::before,
  .hero-actions:has(:global(.hero-ghost:focus-visible)) :global(.hero-ghost)::before {
    transform: scaleX(1);
    transform-origin: left center;
    transition-delay: 300ms;
  }
  .hero-actions:has(:global(.hero-ghost:hover)) :global(.hero-primary)::before,
  .hero-actions:has(:global(.hero-ghost:focus-visible)) :global(.hero-primary)::before {
    transform: scaleX(1);
    transform-origin: left center;
    transition-delay: 860ms;
  }
  .hero-actions:has(:global(.hero-ghost:hover)) :global(.hero-primary),
  .hero-actions:has(:global(.hero-ghost:focus-visible)) :global(.hero-primary) {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    transition-delay: 0s, 860ms, 860ms;
  }
  .hero-actions:has(:global(.hero-ghost:hover)) :global(.hero-ghost),
  .hero-actions:has(:global(.hero-ghost:focus-visible)) :global(.hero-ghost) {
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 113, 227, 0.7);
    transition-delay: 0s, 300ms, 300ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-actions :global(.hero-primary),
    .hero-actions :global(.hero-ghost),
    .hero-actions :global(.hero-primary)::before,
    .hero-actions :global(.hero-ghost)::before {
      transition: none;
      transition-delay: 0s;
    }
  }
</style>
