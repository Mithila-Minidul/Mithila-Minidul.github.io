---
import GlassCard from '../ui/GlassCard.astro';
import Tag from '../ui/Tag.astro';
import { site } from '../../data/site';
---
<section id="about" class="wrap section">
  <h2>About</h2>
  <div class="layout">
    <GlassCard strong>
      {site.about.map((p) => <p>{p}</p>)}
    </GlassCard>
    <div class="skills">
      {site.skills.map((s) => (
        <GlassCard>
          <h3>{s.group}</h3>
          <div class="tags">{s.items.map((i) => <Tag>{i}</Tag>)}</div>
        </GlassCard>
      ))}
    </div>
  </div>
</section>

<style>
  .section { padding-block: 96px; }
  .layout { display: grid; grid-template-columns: 1.2fr 1fr; gap: 20px; align-items: start; }
  .layout :global(p) { margin: 0 0 16px; font-size: var(--text-lg); max-width: 56ch; }
  .layout :global(p:last-child) { margin-bottom: 0; }
  .skills { display: grid; gap: 20px; }
  h3 { margin: 0 0 12px; font-size: 1.1rem; letter-spacing: -0.01em; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; }
  @media (max-width: 760px) { .layout { grid-template-columns: 1fr; } }
</style>