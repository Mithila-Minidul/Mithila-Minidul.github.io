---
import GlassCard from '../ui/GlassCard.astro';
import { site } from '../../data/site';
---
<section id="about" class="wrap section">
  <h2>About</h2>
  <GlassCard strong>
    {site.about.map((p) => <p>{p}</p>)}
  </GlassCard>
</section>

<style>
  .section { padding-block: 96px; }
  .section :global(p) { margin: 0 0 16px; font-size: var(--text-lg); max-width: 56ch; }
  .section :global(p:last-child) { margin-bottom: 0; }
</style>