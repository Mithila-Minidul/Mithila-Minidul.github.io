---
import GlassCard from '../ui/GlassCard.astro';
import SkillIcon from '../ui/SkillIcon.astro';
import Tag from '../ui/Tag.astro';
import { projects } from '../../data/projects';

const projectRows = projects.map((project, index) => ({ project, index }));
const previewThumbnail = (src: string) => {
  const tripCraftPath = '/projects/tripcraft/';
  if (!src.startsWith(tripCraftPath) || !src.endsWith('.png')) return src;

  const filename = src.slice(tripCraftPath.length).replace(/\.png$/i, '.webp');
  return `${tripCraftPath}thumbs/${filename}`;
};
---
<section id="work" class="wrap section">
  <div class="section-heading reveal-item">
    <div>
      <h2>Selected Work</h2>
    </div>
  </div>
  <div class="bento">
    {projectRows.map(({ project, index }) => (
      <div class="project-row reveal-item" style={`--reveal-order: ${index + 1}`}>
        <div class="project-cards">
          <article
            class="project-card"
            data-project={index}
          >
            <GlassCard as="div" strong class="card">
              <div class="project-layout">
                <div class="project-copy">
                  <div class="project-kicker">
                    <span class="project-number">{String(index + 1).padStart(2, '0')}</span>
                    <span>Selected project</span>
                  </div>
                  <h3>{project.title}</h3>
                  <p class="summary">{project.summary}</p>
                  <div class="tags">
                    {project.tags.map((tag) => (
                      <Tag>
                        {project.showStackIcons && <SkillIcon name={tag} />}
                        {tag}
                      </Tag>
                    ))}
                  </div>
                  {(project.repositoryUrl || project.details) && (
                    <div class="project-actions">
                      {project.repositoryUrl && (
                        <a
                          class="repository-link"
                          href={project.repositoryUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`View ${project.title} repository on GitHub`}
                        >
                          <SkillIcon name="GitHub" />
                          <span>View repository</span>
                        </a>
                      )}
                      {project.details && (
                        <button
                          class="details-toggle"
                          type="button"
                          aria-expanded="false"
                          aria-controls={`project-details-${index}`}
                        >
                          <span class="toggle-label">Explore project details</span>
                          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                            <path d="M4.5 10h10m-4-4 4 4-4 4" />
                          </svg>
                        </button>
                      )}
                    </div>
                  )}
                </div>
                <figure
                  class="project-visual"
                  aria-label={`${project.title} project previews. Click to view full screen; swipe or use the left and right arrow keys to browse.`}
                  aria-roledescription="carousel"
                  role="group"
                  tabindex={project.previews?.length ? 0 : undefined}
                  data-preview-carousel={project.previews?.length ? '' : undefined}
                >
                  {project.previews?.length ? (
                    <div class="preview-viewport">
                      <div
                        class="preview-track"
                        style={`width: ${(project.previews.length + 2) * 100}%; transform: translateX(-${100 / (project.previews.length + 2)}%)`}
                      >
                        <div
                          class="preview-slide"
                          aria-hidden="true"
                          style={`flex-basis: ${100 / (project.previews.length + 2)}%`}
                        >
                          <img
                            src={previewThumbnail(project.previews[project.previews.length - 1].src)}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                        {project.previews.map((preview, slideIndex) => (
                          <div
                            class="preview-slide"
                            role="group"
                            aria-roledescription="slide"
                            aria-label={`${preview.alt} (${slideIndex + 1} of ${project.previews?.length ?? 0})`}
                            aria-hidden={slideIndex === 0 ? undefined : 'true'}
                            style={`flex-basis: ${100 / ((project.previews?.length ?? 0) + 2)}%`}
                          >
                            <img
                              src={previewThumbnail(preview.src)}
                              data-full-src={preview.src}
                              alt=""
                              loading="lazy"
                              decoding="async"
                            />
                          </div>
                        ))}
                        <div class="preview-slide" aria-hidden="true" style={`flex-basis: ${100 / (project.previews.length + 2)}%`}>
                          <img
                            src={previewThumbnail(project.previews[0].src)}
                            alt=""
                            loading="lazy"
                            decoding="async"
                          />
                        </div>
                      </div>
                    </div>
                  ) : (
                    <div class="preview-empty">
                      <span>PROJECT PREVIEWS</span>
                      <span>Coming soon</span>
                    </div>
                  )}
                  {project.previews?.length && (
                    <span class="preview-expand-hint" aria-hidden="true">
                      <svg viewBox="0 0 20 20" fill="none">
                        <path d="M7 3.5H3.5V7M13 3.5h3.5V7M3.5 13v3.5H7M16.5 13v3.5H13" />
                      </svg>
                      View full screen
                    </span>
                  )}
                </figure>
              </div>
            </GlassCard>
          </article>
        </div>
        {project.details && (
          <div
            class="detail-panel"
            id={`project-details-${index}`}
            data-project-panel={index}
            aria-hidden="true"
            inert
          >
            <div class="detail-inner">
              <p class="detail-label">PROJECT OVERVIEW</p>
              <p class="overview">{project.details.overview}</p>
              {project.details.highlights.length > 0 && (
                <ul class="highlights">
                  {project.details.highlights.map((highlight) => (
                    <li>
                      <strong>{highlight.title}</strong>
                      <span>{highlight.text}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        )}
      </div>
    ))}
  </div>
</section>

<dialog class="preview-dialog" id="project-preview-dialog" aria-labelledby="preview-dialog-title">
  <div class="preview-dialog-panel">
    <header class="preview-dialog-header">
      <div>
        <p class="preview-dialog-eyebrow">PROJECT PREVIEW</p>
        <h2 id="preview-dialog-title"></h2>
      </div>
      <button class="preview-dialog-close" type="button" aria-label="Close image preview">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18" />
        </svg>
      </button>
    </header>
    <div class="preview-dialog-media" aria-live="polite">
      <img class="preview-dialog-image" src="" alt="" />
      <button class="preview-dialog-nav preview-dialog-previous" type="button" aria-label="Previous project image">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m15 18-6-6 6-6" />
        </svg>
      </button>
      <button class="preview-dialog-nav preview-dialog-next" type="button" aria-label="Next project image">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m9 18 6-6-6-6" />
        </svg>
      </button>
    </div>
    <footer class="preview-dialog-footer">
      <span class="preview-dialog-caption"></span>
      <span class="preview-dialog-count" aria-label="Image number"></span>
    </footer>
  </div>
</dialog>

<style>
  .section { padding-block: 96px; }
  .section.reveal-ready .reveal-item {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(24px);
    transition:
      opacity 820ms ease,
      filter 820ms ease,
      transform 900ms cubic-bezier(0.2, 0.75, 0.25, 1);
    transition-delay: calc(var(--reveal-order, 0) * 130ms);
  }
  .section.reveal-ready .reveal-item.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 36px;
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
  }
  h2 { margin: 0; }
  .section-intro { max-width: 38ch; margin: 0 0 4px; color: var(--slate); }
  .bento { display: grid; gap: 20px; }
  .project-row { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); }
  .project-cards {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: start;
    gap: 20px;
  }
  .project-card { grid-column: span 4; min-width: 0; }
  .project-row:nth-child(even) .project-card { grid-column: 3 / span 4; }
  .bento :global(.card) { padding: 22px; }
  .project-layout {
    display: grid;
    min-height: 224px;
    grid-template-columns: minmax(0, 1fr) minmax(190px, 0.72fr);
    align-items: stretch;
    gap: 24px;
  }
  .project-copy { display: flex; min-width: 0; flex-direction: column; align-items: flex-start; }
  .project-kicker {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 20px;
    color: var(--slate);
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .project-number {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: 9px;
    background: linear-gradient(155deg, rgba(255, 255, 255, 0.94), rgba(221, 235, 255, 0.62));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 3px 8px rgba(49, 77, 119, 0.1);
    color: var(--blue);
    font-size: 0.68rem;
    letter-spacing: 0;
  }
  .bento :global(.card)::before {
    inset: -1px;
    padding: 2px;
    background:
      radial-gradient(
        320px circle at var(--mx, 50%) var(--my, 50%),
        rgba(0, 113, 227, 1),
        rgba(0, 184, 212, 0.82) 30%,
        rgba(0, 113, 227, 0.32) 56%,
        transparent 76%
      ),
      linear-gradient(135deg, var(--glass-edge), rgba(255, 255, 255, 0.12) 40%, rgba(255, 255, 255, 0.55));
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .bento :global(.card)::after {
    background: radial-gradient(160px circle at var(--mx, 50%) var(--my, 0%), rgba(255, 255, 255, 0.28), transparent 60%);
  }
  .bento :global(.card:hover)::before,
  .project-card:focus-within :global(.card)::before {
    opacity: 1;
    filter: drop-shadow(0 0 7px rgba(0, 153, 255, 0.62));
  }
  .bento :global(.card:hover)::after,
  .project-card:focus-within :global(.card)::after {
    opacity: 0.4;
  }
  .project-copy h3 { margin: 0 0 8px; font-size: clamp(1.45rem, 2.4vw, 1.9rem); letter-spacing: -0.035em; }
  .summary { max-width: 48ch; margin: 0 0 18px; color: var(--slate); line-height: 1.55; }
  .project-visual {
    position: relative;
    overflow: hidden;
    min-height: 224px;
    margin: 0;
    border: 1px solid rgba(255, 255, 255, 0.84);
    border-radius: var(--r-md);
    background:
      radial-gradient(ellipse at 18% 0%, rgba(255, 255, 255, 0.96), transparent 58%),
      radial-gradient(ellipse at 85% 100%, rgba(113, 165, 232, 0.34), transparent 66%),
      linear-gradient(145deg, rgba(226, 238, 255, 0.78), rgba(245, 248, 255, 0.42) 48%, rgba(218, 234, 255, 0.66));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.96),
      inset 0 -18px 34px rgba(92, 130, 185, 0.08);
  }
  .project-visual[data-preview-carousel] {
    cursor: zoom-in;
    touch-action: pan-y;
    user-select: none;
  }
  .project-visual[data-preview-carousel]:active { cursor: grabbing; }
  .project-visual[data-preview-carousel]:focus-visible { box-shadow: inset 0 0 0 3px var(--blue); }
  .preview-viewport { position: absolute; inset: 0; overflow: hidden; }
  .preview-track {
    position: absolute;
    inset: 0 auto 0 0;
    display: flex;
    height: 100%;
    transition: transform 650ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }
  .preview-slide { height: 100%; min-width: 0; flex-grow: 0; flex-shrink: 0; overflow: hidden; }
  .preview-slide img { display: block; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .preview-empty {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 7px;
    color: #435b7a;
  }
  .preview-empty span:first-child { font-size: 0.64rem; font-weight: 700; letter-spacing: 0.12em; }
  .preview-empty span:last-child { color: var(--slate); font-size: 0.82rem; }
  .preview-expand-hint {
    position: absolute;
    right: 10px;
    bottom: 10px;
    display: inline-flex;
    min-height: 32px;
    align-items: center;
    gap: 7px;
    padding: 6px 10px;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.78);
    box-shadow: 0 4px 14px rgba(39, 62, 94, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.94);
    color: #435b7a;
    font-size: 0.68rem;
    font-weight: 650;
    pointer-events: none;
    -webkit-backdrop-filter: blur(16px) saturate(150%);
    backdrop-filter: blur(16px) saturate(150%);
  }
  .preview-expand-hint svg { width: 15px; height: 15px; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.5; }
  .preview-dialog {
    position: fixed;
    width: min(94vw, 1120px);
    max-width: none;
    height: min(92dvh, 820px);
    max-height: none;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 24px;
    background: transparent;
    color: var(--ink);
    opacity: 0;
    transform: scale(0.97) translateY(12px);
    transition:
      opacity 300ms ease,
      transform 320ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }
  .preview-dialog[open] { display: grid; }
  .preview-dialog[open].is-visible { opacity: 1; transform: scale(1) translateY(0); }
  .preview-dialog::backdrop {
    background: var(--portfolio-background);
    opacity: 0;
    transition: opacity 320ms ease;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .preview-dialog[open].is-visible::backdrop { opacity: 1; }
  .preview-dialog-panel {
    display: grid;
    min-height: 0;
    grid-template-rows: auto minmax(0, 1fr) auto;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: inherit;
    background: var(--portfolio-background);
    box-shadow: 0 32px 100px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }
  .preview-dialog-header,
  .preview-dialog-footer { display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 18px 22px; }
  .preview-dialog-eyebrow { margin: 0 0 4px; color: var(--slate); font-size: 0.66rem; font-weight: 700; letter-spacing: 0.14em; }
  .preview-dialog-header h2 { margin: 0; color: var(--ink); font-size: 1.15rem; }
  .preview-dialog-close,
  .preview-dialog-nav {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.76);
    background: rgba(10, 18, 30, 0.84);
    color: #fff;
    cursor: pointer;
    -webkit-backdrop-filter: blur(18px);
    backdrop-filter: blur(18px);
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.55), inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }
  .preview-dialog-close { width: 42px; height: 42px; border-radius: 50%; }
  .preview-dialog-close svg { width: 20px; height: 20px; stroke: currentColor; stroke-linecap: round; stroke-width: 1.8; }
  .preview-dialog-media {
    position: relative;
    display: grid;
    min-height: 0;
    overflow: hidden;
    place-items: center;
    background: transparent;
    user-select: none;
  }
  .preview-dialog-image { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; pointer-events: none; }
  .preview-dialog-image.is-entering { animation: preview-image-enter 320ms cubic-bezier(0.22, 1, 0.36, 1) both; }
  @keyframes preview-image-enter {
    from { opacity: 0.35; transform: scale(0.985); }
    to { opacity: 1; transform: scale(1); }
  }
  .preview-dialog-nav { position: absolute; top: 50%; width: 48px; height: 48px; border-radius: 50%; transform: translateY(-50%); }
  .preview-dialog-nav svg { width: 22px; height: 22px; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.8; }
  .preview-dialog-previous { left: 18px; }
  .preview-dialog-next { right: 18px; }
  .preview-dialog-close:hover,
  .preview-dialog-nav:hover { background: rgba(0, 0, 0, 0.96); }
  .preview-dialog-close:focus-visible,
  .preview-dialog-nav:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .preview-dialog-footer { color: var(--slate); font-size: 0.82rem; }
  .preview-dialog-count { flex: 0 0 auto; font-variant-numeric: tabular-nums; }
  .tags { display: flex; flex-wrap: wrap; gap: 9px; margin: auto 0 18px; }
  .tags :global(.tag) {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 8px;
    padding: 7px 11px;
    border: 1px solid rgba(82, 101, 130, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.76);
    color: #3d4654;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.2;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .tags :global(.tag:hover) {
    border-color: rgba(0, 113, 227, 0.18);
    background: rgba(255, 255, 255, 0.86);
  }
  .project-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .repository-link {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 8px;
    color: var(--blue);
    font-size: 0.9rem;
    font-weight: 650;
    text-decoration: none;
  }
  .repository-link:hover { color: #005bb5; text-decoration: underline; text-underline-offset: 3px; }
  .repository-link:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; border-radius: 4px; }
  .details-toggle {
    display: inline-flex;
    min-height: 40px;
    align-items: center;
    gap: 9px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--blue);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 650;
    cursor: pointer;
  }
  .details-toggle svg { width: 18px; height: 18px; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; transition: transform 200ms ease; }
  .details-toggle:hover svg { transform: translateX(4px); }
  .details-toggle:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; border-radius: 4px; }
  .details-toggle[aria-expanded="true"] svg { transform: rotate(90deg); }
  .detail-panel {
    display: grid;
    grid-column: 1 / -1;
    grid-template-rows: 0fr;
    margin-top: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      grid-template-rows 380ms cubic-bezier(0.2, 0.75, 0.25, 1),
      margin-top 380ms cubic-bezier(0.2, 0.75, 0.25, 1),
      opacity 220ms ease,
      visibility 0s linear 380ms;
  }
  .detail-panel.is-open {
    grid-template-rows: 1fr;
    margin-top: 4px;
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s, 40ms, 0s;
  }
  .detail-inner {
    min-height: 0;
    overflow: hidden;
    padding: 0 28px;
    border: 0;
    border-radius: var(--r-lg);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.72), rgba(235, 243, 255, 0.48)), rgba(255, 255, 255, 0.46);
    box-shadow: 0 14px 36px -28px rgba(34, 52, 86, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.94);
    -webkit-backdrop-filter: blur(24px) saturate(170%);
    backdrop-filter: blur(24px) saturate(170%);
    transition: padding 380ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }
  .detail-panel.is-open .detail-inner { padding: 24px 28px; border: 1px solid rgba(255, 255, 255, 0.78); }
  .detail-label { margin: 0 0 10px; color: var(--blue); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.12em; }
  .overview { max-width: 72ch; margin: 0 0 20px; color: var(--ink); line-height: 1.65; }
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .highlights li { display: grid; gap: 4px; }
  .highlights strong { color: var(--ink); font-size: 0.92rem; }
  .highlights span { color: var(--slate); font-size: 0.9rem; line-height: 1.5; }

  @media (max-width: 760px) {
    .section-heading { align-items: start; flex-direction: column; gap: 12px; }
    .project-card,
    .project-row:nth-child(even) .project-card { grid-column: 1 / -1; }
    .project-layout { min-height: 205px; grid-template-columns: minmax(0, 1fr) minmax(140px, 0.72fr); gap: 18px; }
    .project-visual { min-height: 205px; }
  }
  @media (max-width: 520px) {
    .bento :global(.card) { padding: 18px; }
    .project-layout { grid-template-columns: 1fr; gap: 18px; }
    .project-visual { min-height: 180px; grid-row: 1; }
    .project-kicker { margin-bottom: 14px; }
    .tags { margin-bottom: 14px; }
    .detail-panel.is-open .detail-inner { padding: 20px; }
    .preview-dialog { width: 96vw; height: min(88dvh, 720px); border-radius: 18px; }
    .preview-dialog-header,
    .preview-dialog-footer { padding: 14px; }
    .preview-dialog-nav { width: 40px; height: 40px; }
    .preview-dialog-previous { left: 10px; }
    .preview-dialog-next { right: 10px; }
  }
  @media (prefers-reduced-transparency: reduce) {
    .detail-inner { background: #fff; -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bento :global(.card)::before,
    .details-toggle svg,
    .detail-panel,
    .detail-inner { transition: none; }
    .preview-dialog,
    .preview-dialog::backdrop { transition: none; }
    .preview-dialog[open] { opacity: 1; transform: none; }
    .preview-dialog[open]::backdrop { opacity: 1; }
    .preview-track,
    .preview-dialog-image { transition: none; animation: none; }
    .section.reveal-ready .reveal-item,
    .section.reveal-ready .reveal-item.is-visible {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const workSection = document.querySelector<HTMLElement>('#work');
  const workRevealItems = workSection?.querySelectorAll<HTMLElement>('.reveal-item');

  if (
    workSection &&
    workRevealItems?.length &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    workSection.classList.add('reveal-ready');
    workRevealItems.forEach((item) => observer.observe(item));
  }

  const projectToggles = document.querySelectorAll<HTMLButtonElement>('#work .details-toggle');

  for (const toggle of projectToggles) {
    toggle.addEventListener('click', () => {
      const panelId = toggle.getAttribute('aria-controls');
      const panel = panelId ? document.getElementById(panelId) : null;
      if (!panel) return;

      const shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
      for (const openToggle of projectToggles) {
        const openPanelId = openToggle.getAttribute('aria-controls');
        const openPanel = openPanelId ? document.getElementById(openPanelId) : null;
        const isOpen = shouldOpen && openToggle === toggle;

        openToggle.setAttribute('aria-expanded', String(isOpen));
        const label = openToggle.querySelector<HTMLElement>('.toggle-label');
        if (label) label.textContent = isOpen ? 'Close project details' : 'Explore project details';
        if (openPanel) {
          openPanel.classList.toggle('is-open', isOpen);
          openPanel.setAttribute('aria-hidden', String(!isOpen));
          openPanel.inert = !isOpen;
        }
      }
    });
  }

  const previewCarousels = document.querySelectorAll<HTMLElement>('#work [data-preview-carousel]');
  const autoplayDelay = 4800;
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const previewDialog = document.querySelector<HTMLDialogElement>('#project-preview-dialog');
  const dialogImage = previewDialog?.querySelector<HTMLImageElement>('.preview-dialog-image');
  const dialogTitle = previewDialog?.querySelector<HTMLElement>('#preview-dialog-title');
  const dialogCaption = previewDialog?.querySelector<HTMLElement>('.preview-dialog-caption');
  const dialogCount = previewDialog?.querySelector<HTMLElement>('.preview-dialog-count');
  const dialogPrevious = previewDialog?.querySelector<HTMLButtonElement>('.preview-dialog-previous');
  const dialogNext = previewDialog?.querySelector<HTMLButtonElement>('.preview-dialog-next');
  const dialogClose = previewDialog?.querySelector<HTMLButtonElement>('.preview-dialog-close');
  let dialogItems: { src: string; alt: string }[] = [];
  let dialogIndex = 0;
  let dialogTimer = 0;
  let dialogCloseTimer = 0;
  let dialogClosing = false;
  let resumeCarouselAutoplay: (() => void) | null = null;

  const stopDialogAutoplay = () => {
    window.clearTimeout(dialogTimer);
    dialogTimer = 0;
  };

  const scheduleDialogAutoplay = () => {
    stopDialogAutoplay();
    if (!previewDialog?.open || reducedMotion.matches || document.hidden) return;

    dialogTimer = window.setTimeout(() => {
      showDialogImage(dialogIndex + 1);
      scheduleDialogAutoplay();
    }, autoplayDelay);
  };

  const showDialogImage = (index: number) => {
    if (!dialogItems.length || !dialogImage || !dialogCaption || !dialogCount) return;

    dialogIndex = (index + dialogItems.length) % dialogItems.length;
    const item = dialogItems[dialogIndex];
    dialogImage.src = item.src;
    dialogImage.alt = item.alt;
    dialogImage.classList.remove('is-entering');
    void dialogImage.offsetWidth;
    dialogImage.classList.add('is-entering');
    dialogCaption.textContent = item.alt;
    dialogCount.textContent = `${dialogIndex + 1} / ${dialogItems.length}`;
  };

  const closePreviewDialog = () => {
    if (!previewDialog?.open || dialogClosing) return;

    dialogClosing = true;
    previewDialog.classList.remove('is-visible');
    if (reducedMotion.matches) {
      previewDialog.close();
      return;
    }

    const finishClose = (event?: TransitionEvent) => {
      if (event && (event.target !== previewDialog || event.propertyName !== 'transform')) return;
      previewDialog.removeEventListener('transitionend', finishClose);
      window.clearTimeout(dialogCloseTimer);
      dialogCloseTimer = 0;
      if (previewDialog.open) previewDialog.close();
    };

    previewDialog.addEventListener('transitionend', finishClose);
    dialogCloseTimer = window.setTimeout(() => finishClose(), 400);
  };

  if (previewDialog) {
    dialogClose?.addEventListener('click', closePreviewDialog);
    dialogPrevious?.addEventListener('click', () => {
      showDialogImage(dialogIndex - 1);
      scheduleDialogAutoplay();
    });
    dialogNext?.addEventListener('click', () => {
      showDialogImage(dialogIndex + 1);
      scheduleDialogAutoplay();
    });

    previewDialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        showDialogImage(dialogIndex + (event.key === 'ArrowLeft' ? -1 : 1));
        scheduleDialogAutoplay();
      }
    });
    previewDialog.addEventListener('cancel', (event) => {
      event.preventDefault();
    });
    previewDialog.addEventListener('close', () => {
      dialogClosing = false;
      previewDialog.classList.remove('is-visible');
      window.clearTimeout(dialogCloseTimer);
      dialogCloseTimer = 0;
      stopDialogAutoplay();
      resumeCarouselAutoplay?.();
      resumeCarouselAutoplay = null;
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopDialogAutoplay();
      else scheduleDialogAutoplay();
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) stopDialogAutoplay();
      else scheduleDialogAutoplay();
    });
  }

  for (const carousel of previewCarousels) {
    const track = carousel.querySelector<HTMLElement>('.preview-track');
    if (!track) continue;

    const slides = Array.from(track.querySelectorAll<HTMLElement>('.preview-slide'));
    const previewCount = slides.length - 2;
    if (previewCount < 1) continue;

    let currentIndex = 1;
    let autoplayTimer = 0;
    let carouselVisible = !('IntersectionObserver' in window);
    let activePointerId: number | null = null;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let startOffset = 0;
    let horizontalDrag = false;
    let suppressClickUntil = 0;

    const updateAccessibleSlide = () => {
      slides.forEach((slide, index) => {
        const isClone = index === 0 || index === slides.length - 1;
        slide.setAttribute('aria-hidden', String(isClone || index !== currentIndex));
      });
    };

    const setPosition = (index: number, animate = true) => {
      currentIndex = index;
      track.style.transition = animate ? '' : 'none';
      track.style.transform = `translate3d(${-index * carousel.clientWidth}px, 0, 0)`;
      updateAccessibleSlide();

      if (!animate || reducedMotion.matches) normalizeClonedSlide();
      if (!animate) {
        requestAnimationFrame(() => {
          track.style.transition = '';
        });
      }
    };

    const pauseAutoplay = () => {
      window.clearTimeout(autoplayTimer);
      autoplayTimer = 0;
    };

    const scheduleAutoplay = () => {
      pauseAutoplay();
      if (reducedMotion.matches || document.hidden || !carouselVisible) return;

      autoplayTimer = window.setTimeout(() => {
        autoplayTimer = 0;
        if (carousel.matches(':focus-visible') || activePointerId !== null) return;
        setPosition(currentIndex + 1);
        scheduleAutoplay();
      }, autoplayDelay);
    };

    const normalizeClonedSlide = () => {
      if (currentIndex === 0) setPosition(previewCount, false);
      if (currentIndex === previewCount + 1) setPosition(1, false);
    };

    const openPreviewDialog = () => {
      if (!previewDialog || !dialogImage || !dialogTitle) return;

      dialogItems = slides.slice(1, -1).map((slide) => {
        const image = slide.querySelector<HTMLImageElement>('img');
        return {
          src: image?.dataset.fullSrc ?? image?.src ?? '',
          alt: slide.getAttribute('aria-label')?.replace(/\s+\(\d+ of \d+\)$/, '') ?? '',
        };
      });
      dialogItems = dialogItems.filter((item) => item.src);
      if (!dialogItems.length) return;

      const projectTitle = carousel.closest('.project-card')?.querySelector('.project-copy h3')?.textContent?.trim();
      dialogTitle.textContent = projectTitle ?? 'Project preview';
      dialogIndex = Math.max(0, Math.min(previewCount - 1, currentIndex - 1));
      showDialogImage(dialogIndex);
      pauseAutoplay();
      resumeCarouselAutoplay = scheduleAutoplay;
      previewDialog.showModal();
      requestAnimationFrame(() => {
        if (previewDialog.open && !dialogClosing) previewDialog.classList.add('is-visible');
      });
      scheduleDialogAutoplay();
    };

    setPosition(currentIndex, false);
    track.addEventListener('transitionend', (event) => {
      if (event.target === track && event.propertyName === 'transform') normalizeClonedSlide();
    });

    carousel.addEventListener('focusin', pauseAutoplay);
    carousel.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && carousel.contains(event.relatedTarget)) return;
      scheduleAutoplay();
    });

    carousel.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse' && event.button !== 0) return;

      activePointerId = event.pointerId;
      pointerStartX = event.clientX;
      pointerStartY = event.clientY;
      horizontalDrag = false;
      pauseAutoplay();

      const transform = getComputedStyle(track).transform;
      const offset = transform === 'none' ? -currentIndex * carousel.clientWidth : new DOMMatrixReadOnly(transform).m41;
      currentIndex = Math.max(0, Math.min(previewCount + 1, Math.round(-offset / carousel.clientWidth)));
      if (currentIndex === 0 || currentIndex === previewCount + 1) {
        currentIndex = currentIndex === 0 ? previewCount : 1;
      }
      startOffset = -currentIndex * carousel.clientWidth;
      track.style.transition = 'none';
      track.style.transform = `translate3d(${startOffset}px, 0, 0)`;
      updateAccessibleSlide();
      carousel.setPointerCapture(event.pointerId);
    });

    carousel.addEventListener('pointermove', (event) => {
      if (activePointerId !== event.pointerId) return;

      const deltaX = event.clientX - pointerStartX;
      const deltaY = event.clientY - pointerStartY;
      if (!horizontalDrag && Math.abs(deltaX) > 6 && Math.abs(deltaX) > Math.abs(deltaY)) {
        horizontalDrag = true;
      }

      if (horizontalDrag) {
        event.preventDefault();
        track.style.transform = `translate3d(${startOffset + deltaX}px, 0, 0)`;
      }
    });

    const finishPointer = (event: PointerEvent, cancelled = false) => {
      if (activePointerId !== event.pointerId) return;

      const deltaX = event.clientX - pointerStartX;
      const shouldAdvance = !cancelled && horizontalDrag && Math.abs(deltaX) > Math.max(36, carousel.clientWidth * 0.14);
      if (horizontalDrag) suppressClickUntil = performance.now() + 500;
      activePointerId = null;

      if (carousel.hasPointerCapture(event.pointerId)) carousel.releasePointerCapture(event.pointerId);
      setPosition(shouldAdvance ? currentIndex + (deltaX < 0 ? 1 : -1) : currentIndex);
      scheduleAutoplay();
    };

    carousel.addEventListener('pointerup', (event) => finishPointer(event));
    carousel.addEventListener('pointercancel', (event) => finishPointer(event, true));
    carousel.addEventListener('click', (event) => {
      if (performance.now() < suppressClickUntil) {
        event.preventDefault();
        event.stopPropagation();
        return;
      }
      openPreviewDialog();
    });

    carousel.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        openPreviewDialog();
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
        event.preventDefault();
        pauseAutoplay();
        setPosition(currentIndex + (event.key === 'ArrowLeft' ? -1 : 1));
        scheduleAutoplay();
      }
    });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) pauseAutoplay();
      else scheduleAutoplay();
    });
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) {
        pauseAutoplay();
        normalizeClonedSlide();
      }
      else scheduleAutoplay();
    });
    window.addEventListener('resize', () => setPosition(currentIndex, false));

    if ('IntersectionObserver' in window) {
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        carouselVisible = entry.isIntersecting;
        if (carouselVisible) scheduleAutoplay();
        else pauseAutoplay();
      });
      visibilityObserver.observe(carousel);
    }

    scheduleAutoplay();
  }

  const cards = document.querySelectorAll<HTMLElement>('#work .project-card .card');
  for (const card of cards) {
    card.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;
      const bounds = card.getBoundingClientRect();
      card.style.setProperty('--mx', `${event.clientX - bounds.left}px`);
      card.style.setProperty('--my', `${event.clientY - bounds.top}px`);
    });
  }
</script>
