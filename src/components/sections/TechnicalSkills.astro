---
import GlassCard from '../ui/GlassCard.astro';
import SkillIcon from '../ui/SkillIcon.astro';
import Tag from '../ui/Tag.astro';
import { technicalSkills } from '../../data/technical-skills';
---
<section id="skills" class="wrap section">
  <div class="section-heading reveal-item">
    <div>
      <h2>Technical Skills</h2>
    </div>
  </div>
  <div class="groups">
    {technicalSkills.map((group, index) => (
      <div class="skill-entry reveal-item" style={`--reveal-order: ${index + 1}`}>
        <GlassCard as="article" strong class="skill-card">
          <div class="card-heading">
            <div class="group-title">
              <span class="group-index">{String(index + 1).padStart(2, '0')}</span>
              <h3>{group.group}</h3>
            </div>
            <span class="skill-count">{String(group.items.length).padStart(2, '0')} tools</span>
          </div>
          <p class="description">{group.description}</p>
          <ul class="skill-list" aria-label={`${group.group} technologies`}>
            {group.items.map((item) => (
              <li>
                <Tag>
                  <SkillIcon name={item} />
                  {item}
                </Tag>
              </li>
            ))}
          </ul>
        </GlassCard>
      </div>
    ))}
  </div>
</section>

<style>
  .section { padding-block: 96px; }
  .skill-entry { display: flex; min-width: 0; }
  .section.reveal-ready .reveal-item {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(22px);
    transition:
      opacity 800ms ease,
      filter 800ms ease,
      transform 850ms cubic-bezier(0.2, 0.75, 0.25, 1);
    transition-delay: calc(var(--reveal-order, 0) * 110ms);
  }
  .section.reveal-ready .reveal-item.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  .eyebrow {
    margin: 0 0 10px;
    color: var(--blue);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  h2 { margin: 0; }
  .section-intro {
    max-width: 36ch;
    margin: 0 0 4px;
    color: var(--slate);
    font-size: 1rem;
  }
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: 18px;
  }
  .groups :global(.skill-card) {
    display: flex;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 250px;
    flex-direction: column;
    padding: 28px;
    border: 1px solid rgba(255, 255, 255, 0.72);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.68), rgba(255, 255, 255, 0.4));
    box-shadow: 0 14px 36px -28px rgba(34, 52, 86, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.8);
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }
  .groups :global(.skill-card:hover) {
    transform: translateY(-3px);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.48));
    box-shadow: 0 20px 42px -28px rgba(34, 52, 86, 0.48), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  .card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .group-title { display: flex; min-width: 0; align-items: center; gap: 12px; }
  .group-index {
    display: grid;
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: 13px;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.94), rgba(235, 243, 255, 0.72)),
      rgba(255, 255, 255, 0.46);
    box-shadow:
      0 4px 14px rgba(50, 64, 90, 0.15),
      0 0 0 1px rgba(0, 113, 227, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.98),
      inset 0 -1px 0 rgba(255, 255, 255, 0.45);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    backdrop-filter: blur(18px) saturate(180%);
    color: #172033;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    font-weight: 650;
  }
  h3 { margin: 0; font-size: 1.15rem; letter-spacing: -0.025em; line-height: 1.3; }
  .skill-count {
    flex: 0 0 auto;
    color: var(--slate);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
  }
  .description { margin: 18px 0 22px; color: var(--slate); font-size: 0.94rem; }
  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: auto 0 0;
    padding: 0;
    list-style: none;
  }
  .skill-list :global(.tag) {
    display: inline-flex;
    min-height: 38px;
    align-items: center;
    gap: 8px;
    padding: 7px 11px;
    border: 1px solid rgba(82, 101, 130, 0.12);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.58);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.76);
    color: #3d4654;
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.2;
    transition: background 160ms ease, border-color 160ms ease;
  }
  .skill-list :global(.tag:hover) {
    border-color: rgba(0, 113, 227, 0.18);
    background: rgba(255, 255, 255, 0.86);
  }
  @media (max-width: 760px) {
    .section-heading { align-items: start; flex-direction: column; gap: 12px; }
    .groups { grid-template-columns: 1fr; grid-auto-rows: auto; }
    .groups :global(.skill-card) { min-height: 0; }
  }
  @media (max-width: 420px) {
    .groups :global(.skill-card) { padding: 22px; }
    .card-heading { align-items: start; }
    .group-title { gap: 9px; }
    h3 { font-size: 1.05rem; }
    .skill-count { padding-top: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .groups :global(.skill-card), .skill-list :global(.tag) { transition: none; }
    .section.reveal-ready .reveal-item,
    .section.reveal-ready .reveal-item.is-visible {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const skillsSection = document.querySelector<HTMLElement>('#skills');
  const skillRevealItems = skillsSection?.querySelectorAll<HTMLElement>('.reveal-item');

  if (
    skillsSection &&
    skillRevealItems?.length &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    skillsSection.classList.add('reveal-ready');
    skillRevealItems.forEach((item) => observer.observe(item));
  }
</script>
