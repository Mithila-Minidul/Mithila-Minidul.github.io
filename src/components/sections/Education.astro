---
import GlassCard from '../ui/GlassCard.astro';
import { education } from '../../data/education';
---
<section id="education" class="wrap section">
  <h2>Education</h2>
  <div class="timeline">
    {education.map((entry, index) => (
      <article class="timeline-entry" style={`--reveal-order: ${index}`}>
        <GlassCard as="div" strong class="education-card">
          <div class="content">
            <span class="period">
              <span class="period-label">{entry.period}</span>
              <span class="period-shine" aria-hidden="true"></span>
            </span>
            <h3>{entry.institution}</h3>
            <h4>{entry.qualification}</h4>
            <p class="status">{entry.status}</p>
            <ul>
              {entry.highlights.map((highlight) => <li>{highlight}</li>)}
            </ul>
          </div>
          <img class="logo" src={entry.logo} alt={entry.logoAlt} loading="lazy" />
        </GlassCard>
      </article>
    ))}
  </div>
</section>

<style>
  @keyframes education-period-shine {
    0% {
      opacity: 0;
      transform: translateX(0) rotate(-22deg);
    }
    8% { opacity: 1; }
    37% {
      opacity: 0.75;
      transform: translateX(360%) rotate(-22deg);
    }
    45%, 100% {
      opacity: 0;
      transform: translateX(360%) rotate(-22deg);
    }
  }

  .section { padding-block: 96px; }
  h2 { margin-bottom: 40px; }
  .timeline {
    display: grid;
    gap: 24px;
    margin-left: 12px;
    padding-left: 40px;
    border-left: 2px solid rgba(0, 164, 201, 0.6);
  }
  .timeline-entry { position: relative; }
  .timeline-entry::before {
    position: absolute;
    top: 28px;
    left: -51px;
    width: 18px;
    height: 18px;
    border: 3px solid var(--fog);
    border-radius: 50%;
    background: #00b8d4;
    box-shadow: 0 0 18px rgba(0, 184, 212, 0.4);
    content: "";
  }
  .reveal-ready .timeline-entry {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(22px);
    transition:
      opacity 900ms ease,
      filter 900ms ease,
      transform 900ms cubic-bezier(0.2, 0.75, 0.25, 1);
    transition-delay: calc(var(--reveal-order) * 140ms);
  }
  .reveal-ready .timeline-entry.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }
  .reveal-ready .timeline-entry::before {
    scale: 0.65;
    transition: scale 700ms cubic-bezier(0.2, 0.75, 0.25, 1);
    transition-delay: calc(var(--reveal-order) * 140ms + 140ms);
  }
  .reveal-ready .timeline-entry.is-visible::before { scale: 1; }
  .timeline-entry :global(.education-card) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 32px;
  }
  .content { min-width: 0; flex: 1; }
  .logo {
    display: block;
    width: clamp(88px, 13vw, 144px);
    aspect-ratio: 1;
    flex: 0 0 auto;
    border: 1px solid rgba(100, 116, 139, 0.14);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.9);
    object-fit: contain;
    padding: 10px;
  }
  .period {
    position: relative;
    isolation: isolate;
    display: inline-block;
    overflow: hidden;
    align-items: center;
    margin-bottom: 12px;
    padding: 6px 12px;
    border: 1px solid rgba(255, 255, 255, 0.86);
    border-radius: var(--r-pill);
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.94), rgba(235, 243, 255, 0.72)),
      rgba(255, 255, 255, 0.46);
    box-shadow:
      0 4px 14px rgba(50, 64, 90, 0.15),
      0 0 0 1px rgba(0, 113, 227, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.98),
      inset 0 -1px 0 rgba(255, 255, 255, 0.45);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    backdrop-filter: blur(18px) saturate(180%);
    color: #172033;
    font-size: var(--text-sm);
    font-weight: 650;
  }
  .period-label { position: relative; z-index: 2; }
  .period-shine {
    position: absolute;
    z-index: 1;
    top: -45%;
    bottom: -45%;
    left: -32%;
    width: 38%;
    border-radius: var(--r-pill);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(71, 139, 226, 0.34) 28%,
      rgba(255, 255, 255, 0.92) 43%,
      rgba(255, 255, 255, 1) 50%,
      rgba(212, 231, 255, 0.96) 58%,
      rgba(71, 139, 226, 0.4) 74%,
      transparent
    );
    filter: drop-shadow(0 0 6px rgba(0, 113, 227, 0.62));
    opacity: 0;
    pointer-events: none;
    transform: translateX(0) rotate(-22deg);
  }
  .timeline-entry :global(.education-card:hover) .period-shine {
    animation: education-period-shine 3.6s ease-in-out infinite;
  }
  h3 { margin: 0 0 8px; font-size: clamp(1.3rem, 3vw, 1.7rem); line-height: 1.25; }
  h4 { margin: 0 0 6px; color: #008ca3; font-size: 1.1rem; line-height: 1.4; }
  .status { margin: 0; color: var(--slate); font-style: italic; font-weight: 600; }
  ul { display: grid; gap: 8px; margin: 20px 0 0; padding: 0; list-style: none; }
  li { position: relative; padding-left: 20px; color: var(--slate); }
  li::before {
    position: absolute;
    left: 0;
    color: #00a9c5;
    content: "✓";
    font-weight: 700;
  }
  @media (max-width: 600px) {
    .timeline { margin-left: 6px; padding-left: 26px; }
    .timeline-entry::before { left: -37px; width: 16px; height: 16px; }
    .timeline-entry :global(.education-card) { gap: 16px; padding: 24px; }
    .logo { width: 76px; border-radius: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .period-shine { animation: none; }
    .reveal-ready .timeline-entry {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
    .reveal-ready .timeline-entry::before { scale: 1; transition: none; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>('#education');
  const entries = section?.querySelectorAll<HTMLElement>('.timeline-entry');

  if (
    section &&
    entries?.length &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      (observations) => {
        for (const observation of observations) {
          if (!observation.isIntersecting) continue;
          observation.target.classList.add('is-visible');
          observer.unobserve(observation.target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    section.classList.add('reveal-ready');
    entries.forEach((entry) => observer.observe(entry));
  }
</script>
