---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import { quickActions } from '../../data/quick-actions';
---
<nav class="wrap shortcuts" aria-label="Profile shortcuts">
  {
    existsSync(resolve('public', quickActions.cvPath.slice(1))) ? (
      <a class="shortcut download" href={quickActions.cvPath} download={quickActions.cvDownloadName}>
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3.75v10.5m0 0 4-4m-4 4-4-4M5 16.5v2.25c0 .83.67 1.5 1.5 1.5h11c.83 0 1.5-.67 1.5-1.5V16.5" />
          </svg>
        </span>
        <span class="label">
          <strong>Download CV</strong>
          <span>PDF · {quickActions.cvDownloadName}</span>
        </span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    ) : (
      <div class="shortcut unavailable" aria-disabled="true">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="M12 3.75v10.5m0 0 4-4m-4 4-4-4M5 16.5v2.25c0 .83.67 1.5 1.5 1.5h11c.83 0 1.5-.67 1.5-1.5V16.5" />
          </svg>
        </span>
        <span class="label">
          <strong>CV coming soon</strong>
          <span>Add the PDF at public/cv.pdf to enable download</span>
        </span>
      </div>
    )
  }
  <a class="shortcut contact" href="#contact">
    <span class="icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="M20.25 11.5a7.75 7.75 0 0 1-8 7.5 8.7 8.7 0 0 1-3.7-.81L3.75 19.5l1.37-3.8A7.2 7.2 0 0 1 4.25 11.5 7.75 7.75 0 0 1 12.25 4a7.75 7.75 0 0 1 8 7.5Z" />
        <path d="M8.5 11.75h.01m3.74 0h.01m3.74 0h.01" />
      </svg>
    </span>
    <span class="label">
      <strong>Let’s talk</strong>
      <span>Jump to contact details</span>
    </span>
    <span class="arrow" aria-hidden="true">↓</span>
  </a>
</nav>

<style>
  .shortcuts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: -56px;
    padding-bottom: 56px;
  }
  .shortcut {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border: 1px solid rgba(255, 255, 255, 0.78);
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.52);
    box-shadow: 0 12px 32px -24px rgba(34, 52, 86, 0.42), inset 0 1px 0 rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(24px) saturate(160%);
    backdrop-filter: blur(24px) saturate(160%);
    transition: transform 180ms ease, background 180ms ease, box-shadow 180ms ease;
  }
  a.shortcut:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.76);
    box-shadow: 0 16px 36px -24px rgba(34, 52, 86, 0.48), inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  .icon {
    display: grid;
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    place-items: center;
    border: 1px solid rgba(0, 113, 227, 0.12);
    border-radius: 14px;
    background: rgba(0, 113, 227, 0.07);
    color: var(--blue);
  }
  svg { width: 21px; height: 21px; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.7; }
  .label { display: grid; min-width: 0; gap: 3px; }
  strong { color: var(--ink); font-size: 0.96rem; font-weight: 650; }
  .label > span { overflow: hidden; color: var(--slate); font-size: 0.8rem; text-overflow: ellipsis; white-space: nowrap; }
  .arrow { margin-left: auto; color: var(--slate); font-size: 1.1rem; }
  .unavailable { cursor: not-allowed; opacity: 0.74; }
  @media (max-width: 600px) {
    .shortcuts { grid-template-columns: 1fr; margin-top: -40px; padding-bottom: 40px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shortcut { transition: none; }
  }
</style>
