  @media (prefers-reduced-transparency: reduce) {
    .availability {
      background: #e6f3e9;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
</style>

<script>
  const contactSection = document.querySelector<HTMLElement>('#contact');
  const contactReveal = contactSection?.querySelector<HTMLElement>('.contact.reveal-item');

  if (
    contactSection &&
    contactReveal &&
    'IntersectionObserver' in window &&
    !window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        contactReveal.classList.add('is-visible');
        observer.disconnect();
      },
      { threshold: 0.12, rootMargin: '0px 0px -6% 0px' },
    );

    contactSection.classList.add('reveal-ready');
    observer.observe(contactReveal);
  }

  const contactCard = document.querySelector<HTMLElement>('#contact .contact');
  const contactActions = document.querySelector<HTMLElement>('#contact .contact-actions');

  if (contactSection) {
    if ('IntersectionObserver' in window) {
      const visibilityObserver = new IntersectionObserver(([entry]) => {
        contactSection.classList.toggle('is-active', entry.isIntersecting);
        if (!entry.isIntersecting) contactCard?.removeAttribute('data-near');
      }, { rootMargin: '80px 0px' });
      visibilityObserver.observe(contactSection);
    } else {
      contactSection.classList.add('is-active');
    }
  }

  if (contactCard) {
    const proximity = 110;
    const descriptions = Array.from(contactCard.querySelectorAll<HTMLElement>('.contact-description'));
    let pointerFrame = 0;
    let latestPointer: { x: number; y: number } | null = null;

    const updatePointerEffects = () => {
      pointerFrame = 0;
      if (!latestPointer || !contactSection?.classList.contains('is-active')) return;

      const bounds = contactCard.getBoundingClientRect();
      const distanceX = Math.max(bounds.left - latestPointer.x, 0, latestPointer.x - bounds.right);
      const distanceY = Math.max(bounds.top - latestPointer.y, 0, latestPointer.y - bounds.bottom);
      const isNear = bounds.bottom > 0 && bounds.top < window.innerHeight
        && distanceX * distanceX + distanceY * distanceY <= proximity * proximity;

      if (contactCard.dataset.near !== String(isNear)) {
        contactCard.dataset.near = String(isNear);
      }
      if (isNear) {
        for (const description of descriptions) {
          const descriptionBounds = description.getBoundingClientRect();
          description.style.setProperty('--contact-copy-x', `${latestPointer.x - descriptionBounds.left}px`);
          description.style.setProperty('--contact-copy-y', `${latestPointer.y - descriptionBounds.top}px`);
        }
      }
    };

    window.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse' || !contactSection?.classList.contains('is-active')) return;
      latestPointer = { x: event.clientX, y: event.clientY };
      if (!pointerFrame) pointerFrame = requestAnimationFrame(updatePointerEffects);
    }, { passive: true });

    window.addEventListener('blur', () => {
      delete contactCard.dataset.near;
    });
  }

  if (contactActions) {
    let lastSocialButton: 'github' | 'linkedin' | undefined;
    let resetPreviousSocial: number | undefined;

    const trackSocialButton = (event: Event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLElement>('.contact-github, .contact-linkedin, .contact-email');
      if (!button) return;

      if (resetPreviousSocial !== undefined) {
        window.clearTimeout(resetPreviousSocial);
        resetPreviousSocial = undefined;
      }

      if (button.classList.contains('contact-github') || button.classList.contains('contact-linkedin')) {
        const nextSocialButton = button.classList.contains('contact-github') ? 'github' : 'linkedin';
        if (nextSocialButton !== lastSocialButton) {
          contactActions.dataset.previousSocial = lastSocialButton ?? '';
          lastSocialButton = nextSocialButton;
        }
      } else {
        lastSocialButton = undefined;
        contactActions.dataset.previousSocial = '';
      }
    };

    contactActions.addEventListener('pointerover', trackSocialButton);
    contactActions.addEventListener('focusin', trackSocialButton);
    contactActions.addEventListener('pointerleave', () => {
      resetPreviousSocial = window.setTimeout(() => {
        lastSocialButton = undefined;
        contactActions.dataset.previousSocial = '';
        resetPreviousSocial = undefined;
      }, 1500);
    });
  }
</script>
