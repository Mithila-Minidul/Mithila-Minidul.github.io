---
import GlassCard from '../ui/GlassCard.astro';
import Button from '../ui/Button.astro';
import { site } from '../../data/site';
import { siGithub } from 'simple-icons';
---
<section id="contact" class="wrap section">
  <GlassCard strong class="contact">
    <h2>Let's talk</h2>
    <p>
      I’m currently pursuing my software engineering degree and actively seeking an internship where I can contribute to real products and grow with a great team. I’m also open to freelance work and collaborative software projects. If you have an opportunity in mind, let’s connect.
    </p>
    <div class="actions contact-actions">
      <Button href={`mailto:${site.email}`} class="contact-email">
        <span class="button-content">
          <svg class="contact-icon email-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3.75 5.25h16.5A1.75 1.75 0 0 1 22 7v10a1.75 1.75 0 0 1-1.75 1.75H3.75A1.75 1.75 0 0 1 2 17V7a1.75 1.75 0 0 1 1.75-1.75Zm.2 2.1 7.53 5.65a.88.88 0 0 0 1.04 0l7.53-5.65H3.95Zm16.3 1.88-6.53 4.9a2.88 2.88 0 0 1-3.44 0l-6.53-4.9V17c0 .14.11.25.25.25h16a.25.25 0 0 0 .25-.25V9.23Z" />
          </svg>
          <span>Email me</span>
        </span>
      </Button>
      <Button href={site.links.github} variant="ghost" class="contact-github">
        <span class="button-content">
          <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
          <span>GitHub</span>
        </span>
      </Button>
      <Button href={site.links.linkedin} variant="ghost" class="contact-linkedin">
        <span class="button-content">
          <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM3.56 9h3.56v11.45H3.56V9Zm18.66-9H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
          </svg>
          <span>LinkedIn</span>
        </span>
      </Button>
    </div>
  </GlassCard>
</section>

<style>
  @property --contact-glow-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes contact-glow-rotation {
    to { --contact-glow-angle: 360deg; }
  }

  .section { padding-block: 96px; }
  .section :global(.contact) {
    isolation: isolate;
    text-align: center;
    padding: 56px 32px;
    box-shadow:
      var(--shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 0 14px rgba(0, 113, 227, 0.1),
      0 0 30px -12px rgba(0, 184, 212, 0.22);
    transition: box-shadow 320ms ease;
  }
  .section :global(.contact)::after {
    display: none;
  }
  .section :global(.contact)::before {
    inset: -1px;
    padding: 2px;
    border-radius: calc(var(--r-lg) + 1px);
    background: conic-gradient(
      from var(--contact-glow-angle),
      transparent 0deg 210deg,
      rgba(0, 113, 227, 0.35) 238deg,
      rgba(0, 184, 212, 0.9) 258deg,
      rgba(255, 255, 255, 0.95) 266deg,
      rgba(0, 113, 227, 0.78) 276deg,
      transparent 306deg 360deg
    );
    opacity: 0.42;
    filter:
      drop-shadow(0 0 4px rgba(0, 113, 227, 0.3))
      drop-shadow(0 0 10px rgba(0, 184, 212, 0.2));
    transition: opacity 320ms ease, filter 320ms ease;
  }
  .section :global(.contact:hover),
  .section :global(.contact:focus-within),
  .section :global(.contact[data-near="true"]) {
    box-shadow:
      var(--shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 0 18px rgba(0, 113, 227, 0.16),
      0 0 38px -10px rgba(0, 184, 212, 0.3);
  }
  .section :global(.contact:hover)::before,
  .section :global(.contact:focus-within)::before,
  .section :global(.contact[data-near="true"])::before {
    opacity: 0.82;
    filter:
      drop-shadow(0 0 5px rgba(0, 113, 227, 0.48))
      drop-shadow(0 0 14px rgba(0, 184, 212, 0.32));
  }
  .section :global(.contact:hover)::before,
  .section :global(.contact:focus-within)::before {
    animation: contact-glow-rotation 5s linear infinite;
  }
  h2 { margin-bottom: 16px; }
  p {
    margin: 0 auto 28px;
    color: transparent;
    max-width: 44ch;
    font-size: var(--text-lg);
    background-image:
      radial-gradient(
        circle 135px at var(--contact-copy-x, -100px) var(--contact-copy-y, -100px),
        rgba(205, 137, 0, var(--contact-copy-glow, 0)) 0% 38%,
        rgba(205, 137, 0, 0) 100%
      ),
      linear-gradient(var(--slate), var(--slate));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .section :global(.contact[data-near="true"]) p {
    --contact-copy-glow: 1;
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

  .section :global(.contact-actions .btn > span) {
    display: inline-flex;
    align-items: center;
  }
  .section :global(.contact-actions .button-content) { gap: 9px; }
  .section :global(.contact-icon) {
    display: block;
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    fill: currentColor;
  }

  .section :global(.contact-actions .contact-email),
  .section :global(.contact-actions .contact-github),
  .section :global(.contact-actions .contact-linkedin) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    transition:
      transform 0.25s var(--spring),
      color 220ms ease,
      box-shadow 220ms ease;
  }
  .section :global(.contact-actions .contact-email)::before,
  .section :global(.contact-actions .contact-github)::before,
  .section :global(.contact-actions .contact-linkedin)::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .section :global(.contact-actions .contact-email) {
    background: var(--blue);
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 113, 227, 0.7);
  }
  .section :global(.contact-actions .contact-email)::before {
    background: var(--fog);
    transition-delay: 860ms;
  }
  .section :global(.contact-actions .contact-github),
  .section :global(.contact-actions .contact-linkedin) {
    background: var(--glass-strong);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
  }
  .section :global(.contact-actions .contact-github)::before,
  .section :global(.contact-actions .contact-linkedin)::before {
    background: var(--blue);
  }

  .section :global(.contact-actions:has(.contact-github:hover) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-linkedin)::before {
    transform: scaleX(1);
    transition-delay: 300ms;
  }
  .section :global(.contact-actions[data-previous-social="linkedin"]:has(.contact-github:hover) .contact-github)::before,
  .section :global(.contact-actions[data-previous-social="linkedin"]:has(.contact-github:focus-visible) .contact-github)::before {
    transform-origin: right center;
  }
  .section :global(.contact-actions[data-previous-social="github"]:has(.contact-linkedin:hover) .contact-github)::before,
  .section :global(.contact-actions[data-previous-social="github"]:has(.contact-linkedin:focus-visible) .contact-github)::before {
    transform-origin: right center;
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-email)::before {
    transform: scaleX(1);
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-github)::before {
    transition-delay: 860ms;
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-github),
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-github),
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-linkedin),
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-linkedin) {
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 113, 227, 0.7);
    transition-delay: 0s, 300ms, 300ms;
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-email),
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-email),
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-email),
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-email) {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    transition-delay: 0s, 860ms, 860ms;
  }

  .section :global(.contact-actions:has(.contact-email:hover) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-email)::before {
    transform: scaleX(0);
    transition-delay: 0s;
  }
  .section :global(.contact-actions:has(.contact-email:hover) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-email:hover) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-linkedin)::before {
    transform: scaleX(0);
    transition-delay: 860ms;
  }
  .section :global(.contact-actions:has(.contact-email:hover) .contact-email),
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-email) {
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 113, 227, 0.7);
    transition-delay: 0s, 0s, 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .section :global(.contact),
    .section :global(.contact)::before,
    .section :global(.contact-actions .contact-email),
    .section :global(.contact-actions .contact-github),
    .section :global(.contact-actions .contact-linkedin),
    .section :global(.contact-actions .contact-email)::before,
    .section :global(.contact-actions .contact-github)::before,
    .section :global(.contact-actions .contact-linkedin)::before,
    h2,
    p {
      transition: none;
      animation: none;
    }
    .section :global(.contact-actions .contact-email)::before,
    .section :global(.contact-actions .contact-github)::before,
    .section :global(.contact-actions .contact-linkedin)::before {
      transition-delay: 0s;
    }
  }

  @media (max-width: 760px) {
    .section :global(.contact) { padding: 44px 24px; }
  }
</style>

<script>
  const contactCard = document.querySelector<HTMLElement>('#contact .contact');
  const contactActions = document.querySelector<HTMLElement>('#contact .contact-actions');

  if (contactCard) {
    const proximity = 110;

    window.addEventListener('pointermove', (event) => {
      if (event.pointerType !== 'mouse') return;

      const bounds = contactCard.getBoundingClientRect();
      const distanceX = Math.max(bounds.left - event.clientX, 0, event.clientX - bounds.right);
      const distanceY = Math.max(bounds.top - event.clientY, 0, event.clientY - bounds.bottom);
      const isNear = bounds.bottom > 0 && bounds.top < window.innerHeight
        && distanceX * distanceX + distanceY * distanceY <= proximity * proximity;

      contactCard.dataset.near = String(isNear);
      if (isNear) {
        const description = contactCard.querySelector<HTMLElement>('p');
        if (description) {
          const descriptionBounds = description.getBoundingClientRect();
          description.style.setProperty('--contact-copy-x', `${event.clientX - descriptionBounds.left}px`);
          description.style.setProperty('--contact-copy-y', `${event.clientY - descriptionBounds.top}px`);
        }
      }
    });

    window.addEventListener('blur', () => {
      delete contactCard.dataset.near;
    });
  }

  if (contactActions) {
    let lastSocialButton: 'github' | 'linkedin' | undefined;
    let resetPreviousSocial: number | undefined;

    const trackSocialButton = (event: Event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLElement>('.contact-github, .contact-linkedin, .contact-email');
      if (!button) return;

      if (resetPreviousSocial !== undefined) {
        window.clearTimeout(resetPreviousSocial);
        resetPreviousSocial = undefined;
      }

      if (button.classList.contains('contact-github') || button.classList.contains('contact-linkedin')) {
        const nextSocialButton = button.classList.contains('contact-github') ? 'github' : 'linkedin';
        if (nextSocialButton !== lastSocialButton) {
          contactActions.dataset.previousSocial = lastSocialButton ?? '';
          lastSocialButton = nextSocialButton;
        }
      } else {
        lastSocialButton = undefined;
        contactActions.dataset.previousSocial = '';
      }
    };

    contactActions.addEventListener('pointerover', trackSocialButton);
    contactActions.addEventListener('focusin', trackSocialButton);
    contactActions.addEventListener('pointerleave', () => {
      resetPreviousSocial = window.setTimeout(() => {
        lastSocialButton = undefined;
        contactActions.dataset.previousSocial = '';
        resetPreviousSocial = undefined;
      }, 1500);
    });
  }
</script>
