---
import GlassCard from '../ui/GlassCard.astro';
import Button from '../ui/Button.astro';
import SkillIcon from '../ui/SkillIcon.astro';
import Tag from '../ui/Tag.astro';
import { site } from '../../data/site';
import { siGithub } from 'simple-icons';

const expertise = [
  {
    title: 'Mobile apps',
    icon: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 18.5h2"/>',
    stack: ['React Native', 'Expo', 'Flutter'],
  },
  {
    title: 'Full-stack web',
    icon: '<rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 9h18M9 9v11"/>',
    stack: ['React', 'TypeScript', 'Node.js', '.NET'],
  },
  {
    title: 'APIs and databases',
    icon: '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>',
    stack: ['Express.js', 'Spring Boot', 'PostgreSQL', 'MongoDB'],
  },
];
---
<section id="contact" class="wrap section">
  <GlassCard strong class="contact reveal-item">
    <div class="contact-layout">
      <div class="contact-intro">
        <span class="availability">
          <span class="availability-dot" aria-hidden="true"></span>
          <span class="availability-label">Open to opportunities</span>
          <span class="availability-shine" aria-hidden="true"></span>
        </span>
        <h2>Let's talk</h2>
        <span class="opportunity-types">Internships <span aria-hidden="true">·</span> Freelance <span aria-hidden="true">·</span> Collaborations</span>
        <div class="contact-envelope" aria-hidden="true">
          <svg class="contact-envelope-art" viewBox="0 0 360 260" fill="none" focusable="false">
            <defs>
              <linearGradient id="contact-envelope-shell" x1="68" y1="76" x2="292" y2="211" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FFFFFF" stop-opacity="0.88" />
                <stop offset="0.48" stop-color="#DCEBFF" stop-opacity="0.7" />
                <stop offset="1" stop-color="#A7C3EE" stop-opacity="0.58" />
              </linearGradient>
              <linearGradient id="contact-envelope-paper" x1="112" y1="52" x2="250" y2="158" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FFFFFF" stop-opacity="0.98" />
                <stop offset="1" stop-color="#E9F2FF" stop-opacity="0.78" />
              </linearGradient>
              <linearGradient id="contact-envelope-fold" x1="80" y1="102" x2="286" y2="205" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FFFFFF" stop-opacity="0.9" />
                <stop offset="0.52" stop-color="#D7E7FF" stop-opacity="0.76" />
                <stop offset="1" stop-color="#9FBCE9" stop-opacity="0.7" />
              </linearGradient>
              <linearGradient id="contact-envelope-seal" x1="170" y1="151" x2="190" y2="177" gradientUnits="userSpaceOnUse">
                <stop stop-color="#FFFFFF" stop-opacity="0.96" />
                <stop offset="1" stop-color="#83AEEA" stop-opacity="0.84" />
              </linearGradient>
              <radialGradient id="contact-envelope-halo" cx="0" cy="0" r="1" gradientTransform="matrix(0 96 -137 0 180 125)" gradientUnits="userSpaceOnUse">
                <stop stop-color="#B9D7FF" stop-opacity="0.32" />
                <stop offset="1" stop-color="#D8E9FF" stop-opacity="0" />
              </radialGradient>
            </defs>
            <ellipse cx="180" cy="132" rx="137" ry="92" fill="url(#contact-envelope-halo)" />
            <ellipse cx="180" cy="218" rx="103" ry="13" fill="#5277AD" fill-opacity="0.2" filter="blur(8px)" />
            <g class="envelope-glass">
              <rect x="62" y="76" width="236" height="135" rx="22" fill="url(#contact-envelope-shell)" stroke="#FFFFFF" stroke-opacity="0.9" stroke-width="1.5" />
              <path d="M103 126V64a12 12 0 0 1 12-12h130a12 12 0 0 1 12 12v62" fill="url(#contact-envelope-paper)" stroke="#FFFFFF" stroke-opacity="0.9" stroke-width="1.5" />
              <path d="M128 79h101M128 94h82M128 109h91" stroke="#6488BA" stroke-opacity="0.24" stroke-linecap="round" stroke-width="4" />
              <path d="m64 82 116 79L64 198V82Z" fill="url(#contact-envelope-fold)" fill-opacity="0.74" stroke="#FFFFFF" stroke-opacity="0.76" stroke-width="1.2" />
              <path d="m296 82-116 79 116 37V82Z" fill="url(#contact-envelope-fold)" fill-opacity="0.6" stroke="#FFFFFF" stroke-opacity="0.68" stroke-width="1.2" />
              <path d="m64 124 116 73 116-73v67c0 11-9 20-20 20H84c-11 0-20-9-20-20v-67Z" fill="url(#contact-envelope-fold)" stroke="#FFFFFF" stroke-opacity="0.92" stroke-width="1.5" />
              <path d="M68 127 180 198l112-71" stroke="#FFFFFF" stroke-opacity="0.8" stroke-linecap="round" stroke-width="1.4" />
              <path d="M81 91c26 1 43 10 60 23" stroke="#FFFFFF" stroke-opacity="0.78" stroke-linecap="round" stroke-width="3" />
              <circle cx="180" cy="164" r="13" fill="url(#contact-envelope-seal)" stroke="#FFFFFF" stroke-opacity="0.94" stroke-width="1.5" />
              <circle cx="180" cy="164" r="4" fill="#FFFFFF" fill-opacity="0.84" />
            </g>
          </svg>
        </div>
      </div>
      <div class="contact-details">
        <p class="contact-description">
          I’m currently pursuing my software engineering degree and actively seeking an internship where I can contribute to real products and grow with a great team.
        </p>
        <p class="contact-description">
          I’m also open to freelance work and collaborative software projects. If you have an opportunity in mind, let’s connect.
        </p>
        <div class="actions contact-actions">
          <Button href={`mailto:${site.email}`} class="contact-email">
            <span class="button-content">
              <svg class="contact-icon email-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3.75 5.25h16.5A1.75 1.75 0 0 1 22 7v10a1.75 1.75 0 0 1-1.75 1.75H3.75A1.75 1.75 0 0 1 2 17V7a1.75 1.75 0 0 1 1.75-1.75Zm.2 2.1 7.53 5.65a.88.88 0 0 0 1.04 0l7.53-5.65H3.95Zm16.3 1.88-6.53 4.9a2.88 2.88 0 0 1-3.44 0l-6.53-4.9V17c0 .14.11.25.25.25h16a.25.25 0 0 0 .25-.25V9.23Z" />
              </svg>
              <span>Email me</span>
            </span>
          </Button>
          <Button href={site.links.github} variant="ghost" class="contact-github">
            <span class="button-content">
              <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true"><path d={siGithub.path} /></svg>
              <span>GitHub</span>
            </span>
          </Button>
          <Button href={site.links.linkedin} variant="ghost" class="contact-linkedin">
            <span class="button-content">
              <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM3.56 9h3.56v11.45H3.56V9Zm18.66-9H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
              </svg>
              <span>LinkedIn</span>
            </span>
          </Button>
        </div>
      </div>
    </div>
    <div class="contact-expertise">
      <p class="expertise-label">What I can help with</p>
      <ul class="expertise-list">
        {expertise.map((item) => (
          <li>
            <span class="expertise-badge">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={item.icon} />
            </span>
            <strong>{item.title}</strong>
            <div class="expertise-tags">
              {item.stack.map((name) => (
                <Tag><SkillIcon name={name} />{name}</Tag>
              ))}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </GlassCard>
</section>

<style>
  @property --contact-glow-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes contact-glow-rotation {
    to { --contact-glow-angle: 360deg; }
  }

  @keyframes availability-shine {
    0%, 4% {
      opacity: 0;
      transform: translateX(-150%) rotate(-22deg);
    }
    7% { opacity: 0.9; }
    15% {
      opacity: 0.3;
      transform: translateX(500%) rotate(-22deg);
    }
    18%, 100% { opacity: 0; }
  }

  @keyframes contact-envelope-float {
    0%, 100% { transform: perspective(900px) rotateX(8deg) rotateY(-12deg) rotateZ(-4deg) translateY(0); }
    50% { transform: perspective(900px) rotateX(8deg) rotateY(-12deg) rotateZ(-4deg) translateY(-7px); }
  }

  .section { padding-block: 96px; }
  .section.reveal-ready :global(.contact.reveal-item) {
    opacity: 0;
    filter: blur(5px);
    transform: translateY(28px) scale(0.99);
    transition:
      opacity 820ms ease,
      filter 820ms ease,
      transform 900ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }
  .section.reveal-ready :global(.contact.reveal-item.is-visible) {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0) scale(1);
  }
  .section :global(.contact) {
    isolation: isolate;
    padding: clamp(36px, 5vw, 64px);
    box-shadow:
      var(--shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.85),
      0 0 14px rgba(0, 113, 227, 0.1),
      0 0 30px -12px rgba(0, 184, 212, 0.22);
    transition: box-shadow 320ms ease;
  }
  .section :global(.contact)::after {
    display: none;
  }
  .section :global(.contact)::before {
    inset: -1px;
    padding: 2px;
    border-radius: calc(var(--r-lg) + 1px);
    background: conic-gradient(
      from var(--contact-glow-angle),
      transparent 0deg 210deg,
      rgba(0, 113, 227, 0.35) 238deg,
      rgba(0, 184, 212, 0.9) 258deg,
      rgba(255, 255, 255, 0.95) 266deg,
      rgba(0, 113, 227, 0.78) 276deg,
      transparent 306deg 360deg
    );
    opacity: 0.42;
    filter:
      drop-shadow(0 0 4px rgba(0, 113, 227, 0.3))
      drop-shadow(0 0 10px rgba(0, 184, 212, 0.2));
    transition: opacity 320ms ease, filter 320ms ease;
  }
  .section :global(.contact:hover),
  .section :global(.contact:focus-within),
  .section :global(.contact[data-near="true"]) {
    box-shadow:
      var(--shadow),
      inset 0 1px 0 rgba(255, 255, 255, 0.9),
      0 0 18px rgba(0, 113, 227, 0.16),
      0 0 38px -10px rgba(0, 184, 212, 0.3);
  }
  .section :global(.contact:hover)::before,
  .section :global(.contact:focus-within)::before,
  .section :global(.contact[data-near="true"])::before {
    opacity: 0.82;
    filter:
      drop-shadow(0 0 5px rgba(0, 113, 227, 0.48))
      drop-shadow(0 0 14px rgba(0, 184, 212, 0.32));
  }
  .section :global(.contact:hover)::before,
  .section :global(.contact:focus-within)::before {
    animation: contact-glow-rotation 5s linear infinite;
  }
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(36px, 7vw, 88px);
  }
  .contact-intro { min-width: 0; }
  .availability {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    overflow: hidden;
    padding: 11px 16px;
    border: 1px solid rgba(255, 255, 255, 0.74);
    border-radius: var(--r-pill);
    background:
      radial-gradient(130% 180% at 8% 0%, rgba(255, 255, 255, 0.94), transparent 55%),
      radial-gradient(100% 150% at 100% 100%, rgba(84, 157, 103, 0.22), transparent 62%),
      linear-gradient(150deg, rgba(245, 255, 248, 0.78), rgba(201, 234, 210, 0.66) 48%, rgba(147, 198, 160, 0.62)),
      rgba(184, 221, 193, 0.48);
    box-shadow:
      0 12px 26px -14px rgba(34, 90, 51, 0.48),
      0 3px 9px rgba(39, 87, 51, 0.14),
      inset 0 1px 0 rgba(255, 255, 255, 0.98),
      inset 0 -2px 0 rgba(50, 119, 70, 0.26),
      inset 0 0 0 1px rgba(255, 255, 255, 0.34);
    -webkit-backdrop-filter: blur(28px) saturate(210%) contrast(1.06);
    backdrop-filter: blur(28px) saturate(210%) contrast(1.06);
    color: #194a2a;
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1;
  }
  .availability::before,
  .availability::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    content: "";
    pointer-events: none;
  }
  .availability::before {
    z-index: 0;
    padding: 1px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 1), rgba(255, 255, 255, 0.28) 44%, rgba(65, 130, 82, 0.72));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  .availability::after {
    z-index: 0;
    inset: 1px 5px auto;
    height: 72%;
    background:
      radial-gradient(ellipse at 14% 0%, rgba(255, 255, 255, 0.96), transparent 72%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.54), transparent);
  }
  .availability-shine {
    position: absolute;
    z-index: 1;
    top: -45%;
    bottom: -45%;
    left: -45%;
    width: 28%;
    border-radius: var(--r-pill);
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.2) 32%,
      rgba(255, 255, 255, 0.94) 50%,
      rgba(255, 255, 255, 0.2) 68%,
      transparent
    );
    opacity: 0;
    pointer-events: none;
    transform: translateX(-150%) rotate(-22deg);
    animation: availability-shine 7.5s ease-in-out infinite;
  }
  #contact:not(.is-active) .availability-shine,
  #contact:not(.is-active) .contact-envelope-art,
  #contact:not(.is-active) :global(.contact)::before {
    animation-play-state: paused;
  }
  .availability-label,
  .availability-dot {
    position: relative;
    z-index: 2;
  }
  .availability-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 8px;
    border-radius: 50%;
    background: #45a66a;
    box-shadow: 0 0 0 3px rgba(69, 166, 106, 0.12), 0 0 9px rgba(69, 166, 106, 0.34);
  }
  .contact-intro h2 {
    margin: 20px 0 14px;
    font-size: clamp(2.4rem, 5vw, 4rem);
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .opportunity-types {
    color: var(--slate);
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .contact-envelope {
    width: min(100%, 290px);
    margin-top: 24px;
    filter: drop-shadow(0 22px 28px rgba(56, 85, 130, 0.18));
    perspective: 900px;
  }
  .contact-envelope-art {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    transform-style: preserve-3d;
    animation: contact-envelope-float 7s ease-in-out infinite;
  }
  .contact-details { min-width: 0; }
  .contact-description {
    margin: 0 0 14px;
    color: transparent;
    font-size: var(--text-lg);
    line-height: 1.65;
    background-image:
      radial-gradient(
        circle 135px at var(--contact-copy-x, -100px) var(--contact-copy-y, -100px),
        rgba(205, 137, 0, var(--contact-copy-glow, 0)) 0% 38%,
        rgba(205, 137, 0, 0) 100%
      ),
      linear-gradient(var(--slate), var(--slate));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .contact-description:last-of-type { margin-bottom: 28px; }
  .section :global(.contact[data-near="true"]) .contact-description {
    --contact-copy-glow: 1;
  }
  .actions { display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 12px; }

  .section :global(.contact-actions .btn > span) {
    display: inline-flex;
    align-items: center;
  }
  .section :global(.contact-actions .button-content) { gap: 9px; }
    @media (min-width: 481px) {
    .section :global(.contact-actions .button-content) {
      display: inline-flex;
      align-items: center;
      gap: 9px;
    }
  }
  .section :global(.contact-icon) {
    display: block;
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
    fill: currentColor;
  }

  .section :global(.contact-actions .contact-email),
  .section :global(.contact-actions .contact-github),
  .section :global(.contact-actions .contact-linkedin) {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    transition:
      transform 0.25s var(--spring),
      color 220ms ease,
      box-shadow 220ms ease;
  }
  .section :global(.contact-actions .contact-email)::before,
  .section :global(.contact-actions .contact-github)::before,
  .section :global(.contact-actions .contact-linkedin)::before {
    content: "";
    position: absolute;
    z-index: 0;
    inset: 0;
    border-radius: inherit;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 560ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .section :global(.contact-actions .contact-email) {
    background: var(--blue);
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 113, 227, 0.7);
  }
  .section :global(.contact-actions .contact-email)::before {
    background: var(--fog);
    transition-delay: 860ms;
  }
  .section :global(.contact-actions .contact-github),
  .section :global(.contact-actions .contact-linkedin) {
    background: var(--glass-strong);
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
  }
  .section :global(.contact-actions .contact-github)::before,
  .section :global(.contact-actions .contact-linkedin)::before {
    background: var(--blue);
  }

  .section :global(.contact-actions:has(.contact-github:hover) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-linkedin)::before {
    transform: scaleX(1);
    transition-delay: 300ms;
  }
  .section :global(.contact-actions[data-previous-social="linkedin"]:has(.contact-github:hover) .contact-github)::before,
  .section :global(.contact-actions[data-previous-social="linkedin"]:has(.contact-github:focus-visible) .contact-github)::before {
    transform-origin: right center;
  }
  .section :global(.contact-actions[data-previous-social="github"]:has(.contact-linkedin:hover) .contact-github)::before,
  .section :global(.contact-actions[data-previous-social="github"]:has(.contact-linkedin:focus-visible) .contact-github)::before {
    transform-origin: right center;
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-email)::before {
    transform: scaleX(1);
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-github)::before {
    transition-delay: 860ms;
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-github),
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-github),
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-linkedin),
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-linkedin) {
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 113, 227, 0.7);
    transition-delay: 0s, 300ms, 300ms;
  }
  .section :global(.contact-actions:has(.contact-github:hover) .contact-email),
  .section :global(.contact-actions:has(.contact-github:focus-visible) .contact-email),
  .section :global(.contact-actions:has(.contact-linkedin:hover) .contact-email),
  .section :global(.contact-actions:has(.contact-linkedin:focus-visible) .contact-email) {
    color: var(--ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.8);
    transition-delay: 0s, 860ms, 860ms;
  }

  .section :global(.contact-actions:has(.contact-email:hover) .contact-email)::before,
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-email)::before {
    transform: scaleX(0);
    transition-delay: 0s;
  }
  .section :global(.contact-actions:has(.contact-email:hover) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-github)::before,
  .section :global(.contact-actions:has(.contact-email:hover) .contact-linkedin)::before,
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-linkedin)::before {
    transform: scaleX(0);
    transition-delay: 860ms;
  }
  .section :global(.contact-actions:has(.contact-email:hover) .contact-email),
  .section :global(.contact-actions:has(.contact-email:focus-visible) .contact-email) {
    color: #fff;
    box-shadow: 0 10px 24px -10px rgba(0, 113, 227, 0.7);
    transition-delay: 0s, 0s, 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .availability-shine { animation: none; }
    .section.reveal-ready :global(.contact.reveal-item),
    .section.reveal-ready :global(.contact.reveal-item.is-visible) {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
    .section :global(.contact),
    .section :global(.contact)::before,
    .section :global(.contact-actions .contact-email),
    .section :global(.contact-actions .contact-github),
    .section :global(.contact-actions .contact-linkedin),
    .section :global(.contact-actions .contact-email)::before,
    .section :global(.contact-actions .contact-github)::before,
    .section :global(.contact-actions .contact-linkedin)::before,
    .contact-envelope-art,
    h2,
    p {
      transition: none;
      animation: none;
    }
    .section :global(.contact-actions .contact-email)::before,
    .section :global(.contact-actions .contact-github)::before,
    .section :global(.contact-actions .contact-linkedin)::before {
      transition-delay: 0s;
