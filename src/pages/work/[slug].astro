---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import GlassCard from '../../components/ui/GlassCard.astro';
import Tag from '../../components/ui/Tag.astro';
import { caseStudies } from '../../data/case-studies';
import { site } from '../../data/site';

export function getStaticPaths() {
  return caseStudies.map((cs) => ({ params: { slug: cs.slug }, props: { cs } }));
}
const { cs } = Astro.props;
---
<BaseLayout title={`${cs.title} | ${site.name}`} description={cs.subtitle}>
  <Navbar />
  <main class="wrap page">
    <a class="back" href="/#work">Back to work</a>
    <h1>{cs.title}</h1>
    <p class="subtitle">{cs.subtitle}</p>
    <div class="tags">{cs.stack.map((t) => <Tag>{t}</Tag>)}</div>

    <GlassCard strong class="overview">
      <p>{cs.overview}</p>
    </GlassCard>

    <h2>How it works</h2>
    <div class="grid">
      {cs.highlights.map((h) => (
        <GlassCard as="article">
          <h3>{h.title}</h3>
          <p>{h.text}</p>
        </GlassCard>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page { padding-block: 120px 80px; }
  .back { color: var(--slate); font-size: var(--text-sm); }
  .back:hover { color: var(--ink); }
  h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin: 24px 0 8px;
  }
  .subtitle { font-size: var(--text-lg); color: var(--slate); margin: 0 0 20px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 40px; }
  .page :global(.overview) { margin-bottom: 64px; }
  .page :global(.overview) p { margin: 0; font-size: var(--text-lg); max-width: 60ch; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  h3 { margin: 0 0 8px; font-size: 1.25rem; letter-spacing: -0.02em; }
  .grid p { margin: 0; color: var(--slate); }
  @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } }
</style>