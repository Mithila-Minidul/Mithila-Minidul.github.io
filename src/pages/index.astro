---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Work from '../components/sections/Work.astro';
import About from '../components/sections/About.astro';
import Education from '../components/sections/Education.astro';
import TechnicalSkills from '../components/sections/TechnicalSkills.astro';
import Contact from '../components/sections/Contact.astro';
import HeroScene from '../components/scene/HeroScene.tsx';
---
<BaseLayout>
  <Navbar />
  <Hero>
    <HeroScene slot="scene" client:only="react" />
  </Hero>
  <main>
    <About />
    <Education />
    <TechnicalSkills />
    <Work />
    <Contact />
  </main>
  <Footer />
</BaseLayout>