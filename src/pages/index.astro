---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Work from '../components/sections/Work.astro';
import About from '../components/sections/About.astro';
import AboutActions from '../components/sections/AboutActions.astro';
import Education from '../components/sections/Education.astro';
import TechnicalSkills from '../components/sections/TechnicalSkills.astro';
import Contributions from '../components/sections/Contributions.astro';
import Contact from '../components/sections/Contact.astro';
import HeroSceneLoader from '../components/scene/HeroSceneLoader';
---
<BaseLayout>
  <Navbar />
  <Hero>
    <HeroSceneLoader slot="scene" client:idle={{ timeout: 1000 }} />
  </Hero>
  <main>
    <About />
    <AboutActions />
    <Education />
    <TechnicalSkills />
    <Work />
    <Contributions />
    <Contact />
  </main>
  <Footer />
</BaseLayout>